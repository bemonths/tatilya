{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Giriş ve kapanış (giris_kapanis.json)",
  "description": "Girişin ve kapanışın paragrafları (bilgi taşıyan cümlelerde kanıt kimliği [K0123]) ve önerilen yayınlanmış video (yoksa null).",
  "type": "object",
  "additionalProperties": false,
  "required": ["surum", "adim", "giris", "kapanis", "onerilen_video"],
  "properties": {
    "surum": {"const": 1},
    "adim": {"const": "metin_giris_kapanis"},
    "giris": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "kapanis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "onerilen_video": {"type": ["string", "null"]}
  }
}
