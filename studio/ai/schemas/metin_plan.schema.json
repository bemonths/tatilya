{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video metninin planı (plan.json)",
  "description": "5–7 bölüm; her bölümde tek fikir, en çarpıcı an, kanıt kimlikleri (paket_ozeti.md'deki K kimlikleri), kelime bütçesi, açılış biçimi ve notu. Kavramlar hangi bölümde bir kez açıklanacak; yeniden kancalar hangi bölümden sonra ve ne üzerine; başlığın vaatleri hangi bölümlerde karşılanıyor, karşılanamayanlar.",
  "type": "object",
  "additionalProperties": false,
  "required": ["surum", "adim", "bolumler", "kavramlar", "yeniden_kancalar", "vaat_kontrolu", "notlar"],
  "properties": {
    "surum": {"const": 1},
    "adim": {"const": "metin_plan"},
    "bolumler": {"type": "array", "minItems": 5, "maxItems": 7, "items": {"$ref": "#/$defs/bolum"}},
    "kavramlar": {"type": "array", "items": {"$ref": "#/$defs/kavram"}},
    "yeniden_kancalar": {"type": "array", "items": {"$ref": "#/$defs/yeniden_kanca"}},
    "vaat_kontrolu": {"$ref": "#/$defs/vaat_kontrolu"},
    "notlar": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "kimlik": {"type": "string", "pattern": "^K[0-9]{4}$"},
    "bolum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no", "ic_adi", "tek_fikir", "en_carpici_an", "kanitlar", "kelime_butcesi", "acilis_bicimi", "acilis_notu"],
      "properties": {
        "no": {"type": "integer", "minimum": 1, "maximum": 7},
        "ic_adi": {"type": "string", "minLength": 1, "maxLength": 120},
        "tek_fikir": {"type": "string", "minLength": 1},
        "en_carpici_an": {"type": "string", "minLength": 1},
        "kanitlar": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/kimlik"}},
        "kelime_butcesi": {"type": "integer", "minimum": 50, "maximum": 1200},
        "acilis_bicimi": {"enum": ["rakam", "sahne", "soru", "gecmis", "karsilastirma", "diger"]},
        "acilis_notu": {"type": "string", "minLength": 1}
      }
    },
    "kavram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kavram", "bolum"],
      "properties": {
        "kavram": {"type": "string", "minLength": 1},
        "bolum": {"type": "integer", "minimum": 1}
      }
    },
    "yeniden_kanca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bolumden_sonra", "uzerine"],
      "properties": {
        "bolumden_sonra": {"type": "integer", "minimum": 1},
        "uzerine": {"type": "string", "minLength": 1}
      }
    },
    "vaat_kontrolu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["karsilanan", "karsilanamayan"],
      "properties": {
        "karsilanan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vaat", "bolumler"],
            "properties": {
              "vaat": {"type": "string", "minLength": 1},
              "bolumler": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
            }
          }
        },
        "karsilanamayan": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
